            "value" : "⌥ allein geht nur mit F-Tasten oder der Leertaste. Füge ⌘ oder ⌃ hinzu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ alone only works with F keys or Space. Add ⌘ or ⌃"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥ solo funciona con las teclas F o Espacio. Añade ⌘ o ⌃"
