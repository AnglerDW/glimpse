    "「%@」已被其他 App 占用，请换一个" : {
      "comment" : "Shortcut error; %@ is the shortcut",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird bereits von einer anderen App verwendet. Wähle einen anderen Kurzbefehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is already used by another app. Choose a different shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app ya usa “%@”. Elige otra función rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est déjà utilisé par une autre app. Choisissez un autre raccourci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è già usata da un’altra app. Scegli un’altra abbreviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はほかのアプリで使用されています。別のショートカットを設定してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’은(는) 이미 다른 앱에서 사용 중입니다. 다른 단축키를 지정하세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” já está em uso por outro app. Escolha outro atalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» уже используется другим приложением. Выберите другое сочетание."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已被其他 App 占用，请换一个"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已被其他程式佔用，請換一個"
          }
        }
      }
    },
    "「%@」没有注册成功，现在不可用，请换一个" : {
      "comment" : "Shortcut error at launch; %@ is the shortcut",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht registriert werden und funktioniert derzeit nicht. Wähle einen anderen Kurzbefehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” could not be registered and is not working. Choose a different shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo registrar “%@” y ahora no funciona. Elige otra función rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’a pas pu être enregistré et ne fonctionne pas. Choisissez un autre raccourci."
